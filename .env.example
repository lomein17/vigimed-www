# Feature flag: renders the post-repositioning Home at /{locale}/ when 'true'.
# Any other value (or unset) redirects to the chromeless ComingSoon.
# Vercel scoping: Production='true', Staging='true', Development='true'.
# Server-side read; no NEXT_PUBLIC_ prefix, so the value is not inlined into the client bundle.
SHOW_HOME=true

# Comma-separated list of locales that should be publicly accessible in this
# environment. Unset (or empty) means "all locales live", which matches
# staging and local-dev. Production sets LIVE_LOCALES=mx-es to keep the
# unfinished us-en content out of the public site: the proxy 404s /us-en/*,
# generateStaticParams skips it, the sitemap and hreflang map exclude it,
# and the footer locale selector renders a static "Mexico" label instead of
# a toggle. Server-side read; no NEXT_PUBLIC_ prefix.
# LIVE_LOCALES=mx-es
